# 复制为 .env 并按需填写。守护进程(pharos serve)、适配器(pharos mcp)、eval 都读本仓 .env。
# (引擎已折入本仓,不再有第二个 .env 兜底;全部配置统一 PHAROS_* 命名空间。)

# --- 身份(ACL,fail-closed:不设 PHAROS_TENANT 则一切检索返回空)---
# ~/rag_real 示例索引按 tenant=demo / visibility=public 建库,故默认用 demo。
PHAROS_TENANT=demo
PHAROS_PRINCIPALS=

# --- 索引位置(默认 ~/rag_real,由 `pharos index` 生成)---
# PHAROS_INDEX_DIR=~/rag_real
# PHAROS_COLLECTION=real
# PHAROS_DENSE_DIM=1024
# PHAROS_QDRANT_PATH=      # 可选:单独覆盖(默认 <INDEX_DIR>/qdrant)
# PHAROS_SIDECAR_DIR=      # 可选:单独覆盖(默认 <INDEX_DIR>/sidecar)

# --- GPU / 本地模型(dense embedder + reranker;默认 ~/models,须含官方 scripts/)---
# PHAROS_DENSE_MODEL_PATH=~/models/Qwen3-VL-Embedding-8B
# PHAROS_RERANK_MODEL_PATH=~/models/Qwen3-VL-Reranker-8B
# PHAROS_GPU_NAME=4090     # torch device 0 卡名须含此串(防漂到错卡);换卡改此,置空=不校验

# --- 入库 / 解析(pharos index / pharos parse)---
# PHAROS_CORPUS_DIR=       # MinerU 解析产物目录(留仓外);pharos index 默认从这里读
# MINERU_TOKEN_A=          # MinerU 解析 API token(pharos parse 用;可多个轮换 _A/_B/_C)
# MINERU_TOKEN_B=
# MINERU_TOKEN_C=

# --- 服务 ---
# PHAROS_HOST=127.0.0.1
# PHAROS_PORT=8787
# PHAROS_API_KEY=          # legacy 单密钥模式(单人门槛);keys 模式下被忽略
# PHAROS_KEYS_FILE=        # keys 模式(团队,D10):JSON 文件路径(如 ~/pharos.keys.json)。
#                          # 用 `pharos keys new <name> --tenant demo` 生成;chmod 600,勿入 git。
# PHAROS_SMART_ASK=on      # /v1/ask 智能层(数值题表格补检+拒答 hints);off=纯净模式
# PHAROS_MAX_CONTEXT_TOKENS=12000   # 单次检索交付的 token 软上限

# --- 可观测性(D11)---
# PHAROS_LOG_DIR=~/pharos_logs   # 请求日志目录(JSONL);留空=关
# PHAROS_LOG_QUERIES=on          # 日志是否含 query 文本(截 120 字);off=不记录查询内容

# --- LLM(闭管道 /v1/ask 用)---
# DEEPSEEK_API_KEY=
# PHAROS_LLM_BASE_URL=https://api.deepseek.com
# PHAROS_LLM_MODEL=deepseek-v4-flash
# PHAROS_LLM_MAX_TOKENS=2000
# PHAROS_LLM_API_KEY_ENV=DEEPSEEK_API_KEY   # key 从哪个环境变量读(换后端时改)

# --- MCP 薄适配器 / CLI(连守护进程用)---
# PHAROS_URL=http://127.0.0.1:8787

# --- eval(五指标评测;详见 eval/README)---
# PHAROS_EVAL_SRC=~/rag_eval_big              # eval 库路径(独立于生产 ~/rag_real)
# PHAROS_EVAL_COLLECTION=evalbig
# PHAROS_EVAL_GEN_MODEL=deepseek-v4-flash     # 须与 PHAROS_LLM_MODEL 一致(测的是部署配置)
# PHAROS_EVAL_JUDGE_MODEL=deepseek-v4-flash
