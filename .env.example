# 复制为 .env 并按需填写。守护进程(pharos serve)与适配器(pharos mcp)都会读:
# 先读本仓 .env,再读引擎仓(chunk-test-repo)的 .env 兜底(DEEPSEEK_API_KEY 历史上放那边)。

# --- 身份(ACL,fail-closed:不设 PHAROS_TENANT 则一切检索返回空)---
# ~/rag_real 索引按 tenant=demo / visibility=public 建库(个人单用户),故默认用 demo。
PHAROS_TENANT=demo
PHAROS_PRINCIPALS=

# --- 索引位置(默认 ~/rag_real,由 `pharos index` 生成)---
# PHAROS_INDEX_DIR=~/rag_real
# PHAROS_COLLECTION=real
# PHAROS_DENSE_DIM=1024
# PHAROS_QDRANT_PATH=      # 可选:单独覆盖(默认 <INDEX_DIR>/qdrant)
# PHAROS_SIDECAR_DIR=      # 可选:单独覆盖(默认 <INDEX_DIR>/sidecar)

# --- 服务 ---
# PHAROS_HOST=127.0.0.1
# PHAROS_PORT=8787
# PHAROS_API_KEY=          # 可选:设了则所有 /v1/* 需要 X-API-Key 头(/healthz 不需要)
# PHAROS_SMART_ASK=on      # /v1/ask 智能层(数值题表格补检+拒答 hints);off=纯净模式

# --- LLM(闭管道 /v1/ask 用;key 也可放引擎仓 .env)---
# DEEPSEEK_API_KEY=
# PHAROS_LLM_BASE_URL=https://api.deepseek.com
# PHAROS_LLM_MODEL=deepseek-v4-flash
# PHAROS_LLM_MAX_TOKENS=2000
# PHAROS_LLM_API_KEY_ENV=DEEPSEEK_API_KEY   # key 从哪个环境变量读(换后端时改)

# --- MCP 薄适配器 / CLI(连守护进程用)---
# PHAROS_URL=http://127.0.0.1:8787

# --- 引擎仓位置(默认同级 ../chunk-test-repo)---
# PHAROS_ENGINE=

# --- 检索交付预算(透传给引擎 toolcore 的 RAG_MAX_CONTEXT_TOKENS)---
# PHAROS_MAX_CONTEXT_TOKENS=12000
