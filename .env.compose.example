# .env.compose.example — 阶段 E compose 宿主机绑定模板。
# 用法:cp .env.compose.example .env.compose,填下面的值(.env.compose 已在 .gitignore,含密钥绝不入库)。
# 起:docker compose --env-file .env.compose up -d --build
#
# ⚠ 所有路径必须 WSL ext4(WSL 里 realpath ~/xxx),【绝不】/mnt/c/...(8B 模型加载会从分钟级劣化到十几分钟被判死)。

# 模型目录(含 Qwen3-VL-Embedding-8B / Qwen3-VL-Reranker-8B 两个子目录)。挂到 inference 的 /root/models :ro
MODELS_HOST_DIR=/home/<you>/models          # = realpath ~/models

# 索引数据根(含 sidecar/ 子目录;多副本共享。qdrant 向量走 named volume,此处只放 sidecar + pharos_logs)
INDEX_HOST_DIR=/home/<you>/rag_real          # = realpath ~/rag_real

# keys 身份表(明文密钥,绝不入库;单独 :ro 挂进容器 /run/pharos/keys.json——评审 sec-4:不放上面的 RW 数据卷)。
# 生成:cd pharos && PYTHONPATH=src python -m pharos keys new demo --tenant demo --file ~/pharos.keys.json
KEYS_HOST_FILE=/home/<you>/pharos.keys.json  # 放数据根【之外】,与 sidecar/logs 隔离

# 4090 UUID —— 锁死防 FASTEST_FIRST 漂到 5070。取法(WSL 里):nvidia-smi -L,复制 4090 那行括号里的 GPU-...
GPU_UUID=GPU-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ACL 身份(fail-closed:空则一切检索返空)+ collection + 维度
PHAROS_TENANT=demo
PHAROS_COLLECTION=real
PHAROS_DENSE_DIM=1024

# /v1/ask 的 LLM(generator 走 config.py:141 llm_api_key_env 默认读 DEEPSEEK_API_KEY)。不进镜像,仅运行时注入
DEEPSEEK_API_KEY=sk-...
PHAROS_LLM_MODEL=deepseek-v4-flash

# ── 阶段F 调参(全可选,留空用默认)──
# 入口是 nginx: http://127.0.0.1:8080(pharos 副本不发布宿主端口,--scale pharos=N 无冲突)。
# 推理背压:同时在途上限(GPU 前向串行,满则 503 overloaded 让客户端退避)。压测据吞吐调。
INFERENCE_MAX_INFLIGHT=16
# 预热瞬态失败重试次数(耗尽 os._exit(1) 让 restart:unless-stopped 拉起自愈;永久配置错不自杀)
INFERENCE_WARMUP_RETRIES=3
# remote 客户端失败模式(pharos 副本;不设用默认 120s/3s/2/0.5)。阶段F 压测调重试/退避免改码重建镜像:
# PHAROS_INFERENCE_TIMEOUT=120
# PHAROS_INFERENCE_CONNECT_TIMEOUT=3
# PHAROS_INFERENCE_RETRIES=2
# PHAROS_INFERENCE_BACKOFF=0.5
