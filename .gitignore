# ── OS ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor / IDE ────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*~

# ── Python / packaging ──────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# ── Pre-code-drop hygiene (Stage 2 ingest target — block now to
#    prevent accidental commits when the implementation lands) ──────
.env
.env.*
!.env.example
.venv*/
venv/

# Local SQLite + Qdrant data
*.db
*.db-wal
*.db-shm
qdrant_data*/
# root-anchored so these never shadow source packages like src/kb/storage/
/storage/
/images/
nav_index.db

# Logs + audit fallback
/logs/
*.log
audit_fallback*.jsonl

# Eval / benchmark scratch
test_doc/
test_docs/
eval_*.json
eval_results/
golden/

# ── Bench datasets — raw/large PDFs kept local; allowlist the curated
#    pdf_corpus_v1 text corpus (synthetic sources + manifests) that ships. ──
datasets/*
!datasets/pdf_corpus_v1/
!datasets/pdf_corpus_v1/*.jsonl
!datasets/pdf_corpus_v1/*.md
!datasets/pdf_corpus_v1/raw/
!datasets/pdf_corpus_v1/raw/**/
datasets/pdf_corpus_v1/raw/**/*
!datasets/pdf_corpus_v1/raw/**/
!datasets/pdf_corpus_v1/raw/**/.gitkeep
!datasets/pdf_corpus_v1/synthetic_sources/
!datasets/pdf_corpus_v1/synthetic_sources/**/
datasets/pdf_corpus_v1/synthetic_sources/**/*
!datasets/pdf_corpus_v1/synthetic_sources/**/
!datasets/pdf_corpus_v1/synthetic_sources/**/.gitkeep
!datasets/pdf_corpus_v1/synthetic_sources/**/*.md
!datasets/pdf_corpus_v1/derived/
!datasets/pdf_corpus_v1/derived/**/
datasets/pdf_corpus_v1/derived/**/*
!datasets/pdf_corpus_v1/derived/**/
!datasets/pdf_corpus_v1/derived/**/.gitkeep

# Backup outputs
backups/
backup-*/

# Local-only scratchpad
/scratch/
/.notes/
