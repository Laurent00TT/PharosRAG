{
  "ignorePatterns": [
    { "pattern": "^https://github.com/Laurent00TT/navikb/issues" },
    { "pattern": "^https://github.com/Laurent00TT/navikb-workbench" },
    { "pattern": "^\\.\\./\\.\\./" }
  ],
  "replacementPatterns": [
    {
      "pattern": "^/",
      "replacement": "{{BASEURL}}/"
    }
  ],
  "timeout": "20s",
  "retryOn429": true,
  "retryCount": 3,
  "fallbackRetryDelay": "30s",
  "aliveStatusCodes": [200, 206, 403]
}
