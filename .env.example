# Knowledge Base — environment configuration template
# Copy to .env and edit as needed. All vars are optional (Settings has sensible defaults).
#
# This template reflects the current model stack (Qwen3-VL embed/rerank,
# MILCO sparse, Qwen3.6-VL descriptions, MinerU parsing). Point the
# *_SERVER_URL / *_MODEL_ID entries at your own endpoints.

# ── Storage ────────────────────────────────────────────────────────────
# QDRANT_PATH:  always set — used for SQLite job/metadata/feedback DBs even
#               when vectors live in a remote Qdrant server.
# QDRANT_URL:   if non-empty, vectors go to that server (worker + tool_server
#               can share concurrently). Empty = local-file mode (single
#               writer only — worker and tool_server cannot both run).
QDRANT_PATH=./qdrant_data
QDRANT_URL=http://localhost:6333
IMAGE_STORAGE_PATH=./storage/images

# ── Embedding version(决定 Qdrant collection 名) ──────────────────────
# 升模型必须升版本号。命名规范 —— 必须显式编码:
# <embedding_model>_<dim>_<sparse_model>_<sourceview?>_<doc_prune>_<query_prune>_<iter>
EMBEDDING_VERSION=qwen3vl8b_dim4096_milco650_sourceview_docprune30_qprune0_v01

# ── Parser backend ─────────────────────────────────────────────────────
# mineru_local        — CURRENT PRODUCTION: mineru_server.py /parse (×3 instances
#                       on 8101-8103). The deployed path — NOT legacy.
# mineru_api          — OpenDataLab SaaS at mineru.net (requires token)
# mineru_openai_local — experimental mineru-openai-server (protocol still pending
#                       P-10A; NOT yet wired for production)
PARSER_BACKEND=mineru_local

# Round-robin cluster used by mineru_local. For cloud deployment these are the
# SSH-tunneled ports (docker compose overrides to host.docker.internal:8101-8103).
MINERU_SERVER_URL=http://localhost:8101

# ── PoC v1.1 new-stack service URLs ────────────────────────────────────
# Reachable however you like (e.g. an SSH reverse tunnel to a remote GPU host) —
# point these at your own endpoints.
MULTIMODAL_EMBEDDING_SERVER_URL=http://localhost:8003
MULTIMODAL_EMBEDDING_MODEL_ID=qwen3-vl-embed
RERANKER_SERVER_URL=http://localhost:8005
RERANKER_MODEL_ID=qwen3-vl-rerank

# Sparse (MILCO) runs locally on CPU
SPARSE_SERVER_URL=http://localhost:8004
SPARSE_MODEL=omai-research/milco-650m
# ⚠️ For production, pin MILCO to a specific commit sha (reproducibility +
# supply-chain safety) rather than tracking a moving branch.
SPARSE_MODEL_REVISION=main
SPARSE_DOC_PRUNE_RATIO=0.3
SPARSE_QUERY_PRUNE_RATIO=0.0
SPARSE_USE_SOURCE_VIEW=true

# Qwen3-VL-Embedding query instruction prefix (model card recommended)
# EMBEDDING_QUERY_INSTRUCTION="Instruct: Given a web search query, retrieve relevant passages that answer the query\nQuery: "
EMBEDDING_OUTPUT_DIM=0  # 0 = native 4096; set 1024/2048 to enable MRL truncation (bumps embedding_version)

# ── MinerU 模型源 ─────────────────────────────────────────────────────
# modelscope: 国内 CDN (默认推荐)
# huggingface: 海外或有梯子
# local: 完全离线 — 必须先手动下好模型并配 ~/mineru.json
MINERU_MODEL_SOURCE=modelscope

# ── HuggingFace endpoint ──────────────────────────────────────────────
# 国内必设 hf-mirror,否则 MILCO / Qwen3-VL 等模型可能 SSL EOF
HF_ENDPOINT=https://hf-mirror.com

# ── LLM backends(主进程 LLM 调用) ────────────────────────────────────
# DESCRIPTION_*   — per-page JSON descriptions (fixed schema, thinking off)
# AGENT_*         — multi-turn tool loop, vision-capable
# QUERY_REWRITE_* — HyDE + Multi-Query short structured tasks
#
# ⚠️ 场景差异：下面的默认值面向 LOCAL 裸 python 开发（LM Studio @ :1235）。
# docker-compose 部署会把 DESCRIPTION_* OVERRIDE 成云端 VLM
# (host.docker.internal:8006 / qwen3.6-vl，经 SSH 隧道) —— 见
# docker/docker-compose.local.yml + the project README。
#
# ⚠️ KNOWN ISSUE: Claude SDK Bridge / a local proxy DOES NOT FORWARD `tools`.
# AGENT_ADAPTER=anthropic with a local Bridge WILL break tool-calling.
# Keep AGENT_ADAPTER=openai_compat until Bridge ships tools forwarding.

DESCRIPTION_ADAPTER=openai_compat
DESCRIPTION_URL=http://localhost:1235/v1
DESCRIPTION_API_KEY=lm-studio
DESCRIPTION_MODEL=qwen3.6-27b
DESCRIPTION_SUPPORTS_VISION=true

AGENT_ADAPTER=openai_compat
AGENT_URL=http://localhost:1235/v1
AGENT_API_KEY=lm-studio
AGENT_MODEL=qwen3.6-27b
AGENT_SUPPORTS_VISION=true
AGENT_MAX_IMAGES_PER_TURN=3
AGENT_MAX_IMAGE_BYTES_PER_TURN=8000000

QUERY_REWRITE_ADAPTER=openai_compat
QUERY_REWRITE_URL=http://localhost:1235/v1
QUERY_REWRITE_API_KEY=lm-studio
QUERY_REWRITE_MODEL=qwen3.6-27b
QUERY_REWRITE_SUPPORTS_VISION=false

# ── Search defaults ───────────────────────────────────────────────────
KB_PROFILE=balanced
HYDE_ENABLED=true
MULTI_QUERY_ENABLED=true
MULTI_QUERY_N=3
SEARCH_PLANNER_ENABLED=true
SEARCH_PROFILE=balanced
SEARCH_LOW_CONFIDENCE_THRESHOLD=0.2

# ── Background ingestion jobs ─────────────────────────────────────────
JOB_WORKER_POLL_INTERVAL_S=2.0
JOB_WORKER_LEASE_SECONDS=60
JOB_WORKER_HEARTBEAT_INTERVAL_S=0.0

# ── Observability ─────────────────────────────────────────────────────
LOG_DIR=./logs
LOG_MAX_MB=50
LOG_BACKUP_COUNT=5

# ── Navigation index ───────────────────────────────────────────────────
NAV_ENABLED=true
NAV_DB_PATH=./qdrant_data/nav_index.db
NAV_SCHEMA_VERSION=nav-v1
NAV_AUTO_BUILD_ON_INGEST=true
NAV_MAX_ALIASES_PER_ENTRY=20
NAV_MAX_ENTRIES_PER_DOC=5000
NAV_VECTOR_ENABLED=true
NAV_GRAPH_EXPAND_DEPTH=1
NAV_FETCH_WINDOW_PAGES=1

# ── MCP ───────────────────────────────────────────────────────────────
MCP_ENABLE_RESOURCES=true
MCP_ENABLE_PROMPTS=true
MCP_ENABLE_WRITE_TOOLS=false
MCP_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
MCP_TOOL_TEXT_BUDGET=800
MCP_TOOL_RESULT_LIMIT=20

# ── Hybrid navigator ──────────────────────────────────────────────────
HYBRID_NAV_ENABLED=true
HYBRID_TRACE_ENABLED=true
HYBRID_ROUTER_MIN_SAMPLES_FOR_TRAINING=200
