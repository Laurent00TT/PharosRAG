# NaviKB — local 4090-48G all-online .env (copy to repo-root as `.env`)
# Topology: everything runs in WSL2; all services on localhost. NOT docker, NO tunnel.
# Models: embed/rerank/gen all FP8 in vLLM; sparse=MILCO on CPU; mineru ×1 local.

# ── Storage (all-online REQUIRES Qdrant server mode; local-file is single-writer) ──
QDRANT_PATH=./qdrant_data
QDRANT_URL=http://localhost:6333
IMAGE_STORAGE_PATH=./storage/images

# ── Embedding version — bumped v01->v02 to mark the FP8 precision change ──
# (dim stays 4096; FP8 quantizes weights, not the output vector — but query/doc
#  numeric drift means a fresh collection + re-ingest.)
EMBEDDING_VERSION=qwen3vl8b_dim4096_milco650_sourceview_docprune30_qprune0_v02

# ── Parser: local MinerU (single instance on 8101) ──
PARSER_BACKEND=mineru_local
MINERU_SERVER_URL=http://localhost:8101
MINERU_MODEL_SOURCE=modelscope

# ── Retrieval model endpoints (WSL localhost) ──
MULTIMODAL_EMBEDDING_SERVER_URL=http://localhost:8003
MULTIMODAL_EMBEDDING_MODEL_ID=qwen3-vl-embed
RERANKER_SERVER_URL=http://localhost:8005
RERANKER_MODEL_ID=qwen3-vl-rerank
SEARCH_DISABLE_RERANKER=false

# ── Sparse (MILCO) — server on CPU, client just calls it ──
SPARSE_SERVER_URL=http://localhost:8004
SPARSE_MODEL=omai-research/milco-650m
SPARSE_MODEL_REVISION=main
SPARSE_DOC_PRUNE_RATIO=0.3
SPARSE_QUERY_PRUNE_RATIO=0.0
SPARSE_USE_SOURCE_VIEW=true

EMBEDDING_OUTPUT_DIM=0
HF_ENDPOINT=https://hf-mirror.com

# ── Generation VLM (Qwen3-VL-8B-Instruct-FP8 @ 8006, served-model-name qwen3.6-vl) ──
# One model serves all three generation roles: description / agent / query-rewrite.
DESCRIPTION_ENABLED=true
DESCRIPTION_ADAPTER=openai_compat
DESCRIPTION_URL=http://localhost:8006/v1
DESCRIPTION_API_KEY=EMPTY
DESCRIPTION_MODEL=qwen3.6-vl
DESCRIPTION_SUPPORTS_VISION=true

AGENT_ADAPTER=openai_compat
AGENT_URL=http://localhost:8006/v1
AGENT_API_KEY=EMPTY
AGENT_MODEL=qwen3.6-vl
AGENT_SUPPORTS_VISION=true
AGENT_MAX_IMAGES_PER_TURN=3

QUERY_REWRITE_ADAPTER=openai_compat
QUERY_REWRITE_URL=http://localhost:8006/v1
QUERY_REWRITE_API_KEY=EMPTY
QUERY_REWRITE_MODEL=qwen3.6-vl
QUERY_REWRITE_SUPPORTS_VISION=false

# ── Search defaults ──
KB_PROFILE=balanced
HYDE_ENABLED=true
MULTI_QUERY_ENABLED=true
MULTI_QUERY_N=3
SEARCH_PLANNER_ENABLED=true

# ── Background ingestion jobs / Nav / MCP ──
JOB_WORKER_POLL_INTERVAL_S=2.0
NAV_ENABLED=true
NAV_AUTO_BUILD_ON_INGEST=true
MCP_ENABLE_RESOURCES=true
MCP_ENABLE_PROMPTS=true
MCP_ENABLE_WRITE_TOOLS=false
